<?xml version="1.0" encoding="UTF-8"?>
<!--
  Senarath Bank FMS - IIS site configuration.
  The PHP FastCGI handler is registered at server level by setup\Install-SenarathFMS.ps1
  (the <handlers> section is locked at site level by default).
-->
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>

    <directoryBrowse enabled="false" />

    <!-- let PHP's own 401/403/404/500 pages through (and keep the X-SB-* headers) -->
    <httpErrors existingResponse="PassThrough" />

    <security>
      <requestFiltering>
        <!-- block direct web access to code includes, database and session files -->
        <hiddenSegments>
          <add segment="includes" />
          <add segment="data" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".sqlite" allowed="false" />
          <add fileExtension=".log" allowed="false" />
          <add fileExtension=".md" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="same-origin" />
      </customHeaders>
    </httpProtocol>

    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="1.00:00:00" />
    </staticContent>
  </system.webServer>
</configuration>
